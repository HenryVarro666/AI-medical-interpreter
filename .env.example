# ============================================================================
# Copy this file to `.env` and fill in the real values before running.
# ============================================================================

# --- OpenAI ---------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Realtime model. Keep in sync with the latest Realtime snapshot in the docs.
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17

# Preset voice used by OpenAI Realtime TTS.
# Options: alloy | ash | ballad | coral | echo | sage | shimmer | verse
VOICE=alloy

# --- Server ---------------------------------------------------------------
PORT=5050

# Public hostname that Twilio can reach (no protocol, no trailing slash).
# Locally: use the ngrok / Cloudflare Tunnel host, e.g. abc123.ngrok-free.app
# In prod: your own domain.
PUBLIC_HOST=your-ngrok-host.ngrok-free.app

# --- Translation behaviour ------------------------------------------------
# Language pair hints passed into the system prompt. Any language OpenAI
# supports is fine; these two just seed the translator.
SPEAKER_A_LANG=Chinese
SPEAKER_B_LANG=English

# --- Medical dashboard & compliance ---------------------------------------
# Live transcript dashboard (disable with false if not needed)
ENABLE_DASHBOARD=true

# How long to keep ended sessions in memory (minutes)
SESSION_TTL_MINUTES=60

# Append-only audit log path (HIPAA compliance trail)
AUDIT_LOG_PATH=data/audit.log

# Set to true to log transcript content to console (WARNING: contains PHI)
DEBUG_LOG_TRANSCRIPTS=false

# --- Mixed language / code-switching ---------------------------------------
# Post-ASR transcript cleaning via GPT-4o-mini. Corrects Whisper errors
# in code-switched speech (e.g., Chinese with English medical terms).
# Adds ~200-400ms latency to transcript text (audio pipeline unaffected).
ENABLE_TRANSCRIPT_CLEANING=false

# Whisper language hint (ISO 639-1). Biases ASR toward expected primary
# language. 'zh' for Chinese-dominant speakers, 'en' for English-dominant.
# Leave empty for auto-detect (works for most cases).
WHISPER_LANGUAGE_HINT=

# --- Session mode ---------------------------------------------------------
# 'translator' = real-time bidirectional translation (default)
# 'intake'     = AI medical intake operator mode (structured patient interview)
DEFAULT_MODE=translator

# --- Call guard / abuse prevention ----------------------------------------
# Max concurrent calls (rejects new calls when at capacity)
MAX_CONCURRENT_CALLS=5

# Max call duration in minutes (auto-hangs-up after this)
MAX_CALL_DURATION_MIN=30

# Max continuous silence in seconds before warning
MAX_SILENCE_SEC=60

# Rate limiting: max calls per number within the time window
RATE_LIMIT_WINDOW_MIN=10
RATE_LIMIT_MAX_CALLS=10

# --- Future: voice-cloning bridge ----------------------------------------
# When ENABLE_VOICE_CLONE=true the server will pipe OpenAI's audio through
# an external TTS layer (e.g. ElevenLabs) before returning it to Twilio.
# Leave false until you've implemented src/tts-bridge.js.
ENABLE_VOICE_CLONE=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
